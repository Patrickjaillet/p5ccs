<ui:FluentWindow x:Class="P5CCS.App.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:P5CCS.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
                 Title="About"
                 Height="520" Width="640"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="About" CanMaximize="False" ShowMaximize="False" ShowMinimize="False" />

        <TabControl Grid.Row="1" Margin="16">
            <TabItem Header="About">
                <StackPanel Margin="16">
                    <ui:SymbolIcon Symbol="Code24" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Static vm:AboutViewModel.ProductName}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                    <TextBlock Text="{Binding VersionText}"
                               HorizontalAlignment="Center"
                               Opacity="0.7"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{x:Static vm:AboutViewModel.CopyrightText}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0" />

                    <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Hyperlink NavigateUri="{x:Static vm:AboutViewModel.ContactMailtoUri}"
                                   RequestNavigate="OnMailtoRequestNavigate">
                            <Run Text="{x:Static vm:AboutViewModel.ContactEmail}" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Hyperlink NavigateUri="{x:Static vm:AboutViewModel.WebsiteUri}"
                                   RequestNavigate="OnWebsiteRequestNavigate">
                            <Run Text="{x:Static vm:AboutViewModel.WebsiteUrl}" />
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock HorizontalAlignment="Center" Margin="0,24,0,0" Text="Licensed under the MIT License." />
                </StackPanel>
            </TabItem>
            <TabItem Header="License">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <TextBox Text="{Binding LicenseText, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             TextWrapping="Wrap"
                             FontFamily="Consolas" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Third-Party Notices">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <TextBox Text="{Binding ThirdPartyNoticesText, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             TextWrapping="Wrap"
                             FontFamily="Consolas" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
