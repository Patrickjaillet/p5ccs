<ui:FluentWindow x:Class="P5CCS.App.ExportWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:P5CCS.App.ViewModels"
                 xmlns:converters="clr-namespace:P5CCS.App.Converters"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:ExportViewModel}"
                 Title="Export"
                 Height="640" Width="720"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Export" CanMaximize="False" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Format" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding SelectedFormat}" Margin="0,0,0,12" />

                <TextBlock Text="Resolution" FontWeight="SemiBold" Margin="0,0,0,4" />
                <WrapPanel Margin="0,0,0,12">
                    <TextBlock Text="Width" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ui:NumberBox Value="{Binding Width, Mode=TwoWay}" Width="80" Margin="0,0,12,0" Minimum="16" Maximum="8192" />
                    <TextBlock Text="Height" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ui:NumberBox Value="{Binding Height, Mode=TwoWay}" Width="80" Minimum="16" Maximum="8192" />
                </WrapPanel>

                <StackPanel Visibility="{Binding IsStillFormat, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock Text="Frame Rate (fps)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ui:NumberBox Value="{Binding Fps, Mode=TwoWay}" Width="100" HorizontalAlignment="Left" Minimum="1" Maximum="120" Margin="0,0,0,12" />

                    <TextBlock Text="Duration (seconds)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ui:NumberBox Value="{Binding DurationSeconds, Mode=TwoWay}" Width="100" HorizontalAlignment="Left" Minimum="0.1" Maximum="600" Margin="0,0,0,12" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowJpegOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="JPEG Quality" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Slider Minimum="1" Maximum="100" Value="{Binding JpegQuality, Mode=TwoWay}" Margin="0,0,0,12" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowGifOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="GIF Colors" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Slider Minimum="2" Maximum="256" Value="{Binding GifColorCount, Mode=TwoWay}" Margin="0,0,0,12" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowVideoOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Quality (CRF, WebM only — lower is better)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Slider Minimum="0" Maximum="63" Value="{Binding VideoConstantRateFactor, Mode=TwoWay}" Margin="0,0,0,12" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowMp4Options, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="MP4 Bitrate (kbps)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ui:NumberBox Value="{Binding Mp4BitrateKbps, Mode=TwoWay}" Width="100" HorizontalAlignment="Left" Minimum="100" Maximum="50000" Margin="0,0,0,12" />
                </StackPanel>

                <TextBlock Text="Destination Folder" FontWeight="SemiBold" Margin="0,0,0,4" />
                <WrapPanel Margin="0,0,0,4">
                    <TextBox Text="{Binding DestinationFolder}" Width="220" Margin="0,0,4,0" />
                    <Button Content="Browse..." Command="{Binding BrowseDestinationCommand}" Padding="8,2" />
                </WrapPanel>
                <TextBlock Text="{Binding FileNamePreview}" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,12" />

                <Button Content="Add to Queue" Command="{Binding AddToQueueCommand}" HorizontalAlignment="Left" Padding="10,4" />
            </StackPanel>

            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="Export Queue" FontWeight="SemiBold" Margin="0,0,0,8" />

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <ProgressBar Height="8" Minimum="0" Maximum="1" Value="{Binding OverallProgressFraction, Mode=OneWay}"
                                 Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding ProgressStatusText}" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,8"
                               Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <WrapPanel>
                        <Button Content="Start Export" Command="{Binding StartQueueCommand}" Padding="10,4" Margin="0,0,4,0"
                                Visibility="{Binding IsExporting, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <Button Content="Cancel" Command="{Binding CancelExportCommand}" Padding="10,4"
                                Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </WrapPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Queue}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ExportQueueItemViewModel}">
                                <Border Margin="0,0,0,6" Padding="6" CornerRadius="4" Background="#14808080">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1" Content="✕" Padding="4,0"
                                                    Command="{Binding DataContext.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                        <TextBlock Text="{Binding StatusText}" Opacity="0.7" FontSize="11" />
                                        <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding ErrorMessage}"
                                                   Foreground="IndianRed"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
