<Window x:Class="P5CCS.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Width="480"
        Height="260">
    <Border BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="1"
                       Text="Processing 5"
                       Foreground="White"
                       FontSize="32"
                       FontWeight="Light"
                       HorizontalAlignment="Center" />
            <TextBlock Grid.Row="2"
                       Text="Creative Coding Station"
                       Foreground="#B0B0B0"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0" />
            <TextBlock x:Name="VersionTextBlock"
                       Grid.Row="3"
                       Foreground="#808080"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0" />
        </Grid>
    </Border>
</Window>
