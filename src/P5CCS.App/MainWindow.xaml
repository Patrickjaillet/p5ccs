<ui:FluentWindow x:Class="P5CCS.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:xcad="https://github.com/Dirkster99/AvalonDock"
                 xmlns:xcadThemes="clr-namespace:AvalonDock.Themes.WPFUI;assembly=AvalonDock.Themes.WPFUI"
                 xmlns:vm="clr-namespace:P5CCS.App.ViewModels"
                 xmlns:engine="clr-namespace:P5CCS.Engine;assembly=P5CCS.Engine"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
                 Title="Processing 5 - Creative Coding Station"
                 Height="720" Width="1200"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Processing 5 - Creative Coding Station" />

        <Menu Grid.Row="1">
            <MenuItem Header="_File">
                <MenuItem Header="_New Sketch" Command="{Binding NewSketchCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Open Sketch..." Command="{Binding OpenSketchCommand}" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="_Save" Command="{Binding SaveSketchCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As..." Command="{Binding SaveSketchAsCommand}" />
                <Separator />
                <MenuItem Header="_Close Tab" Command="{Binding CloseTabCommand}" InputGestureText="Ctrl+W" />
                <MenuItem Header="Close A_ll Tabs" Command="{Binding CloseAllTabsCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" />
                <MenuItem Header="_Redo" Command="ApplicationCommands.Redo" />
                <Separator />
                <MenuItem Header="Cu_t" Command="ApplicationCommands.Cut" />
                <MenuItem Header="_Copy" Command="ApplicationCommands.Copy" />
                <MenuItem Header="_Paste" Command="ApplicationCommands.Paste" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Light Theme" Command="{Binding SetLightThemeCommand}" />
                <MenuItem Header="_Dark Theme" Command="{Binding SetDarkThemeCommand}" />
                <MenuItem Header="_System Theme" Command="{Binding SetSystemThemeCommand}" />
                <Separator />
                <MenuItem Header="Toggle Theme" Command="{Binding ToggleThemeCommand}" InputGestureText="Ctrl+T" />
                <Separator />
                <MenuItem Header="Show _Grid" IsCheckable="True" IsChecked="{Binding ShowGrid}" />
                <MenuItem Header="_Fullscreen Viewport" Command="{Binding FullscreenViewportCommand}" InputGestureText="F11" />
            </MenuItem>
            <MenuItem Header="_Sketch">
                <MenuItem Header="_Run" Command="{Binding RunCommand}" InputGestureText="F5" />
                <MenuItem Header="_Pause" Command="{Binding PauseCommand}" />
                <MenuItem Header="_Stop" Command="{Binding StopCommand}" InputGestureText="Shift+F5" />
                <MenuItem Header="Re_set" Command="{Binding ResetCommand}" InputGestureText="Ctrl+F5" />
            </MenuItem>
            <MenuItem Header="E_xport">
                <MenuItem Header="_Quick Export..." Command="{Binding QuickExportCommand}" InputGestureText="Ctrl+E" />
            </MenuItem>
            <MenuItem Header="_Window">
                <MenuItem Header="Close All Tabs" Command="{Binding CloseAllTabsCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <ToolBar Grid.Row="2">
            <Button Command="{Binding RunCommand}" ToolTip="Run">
                <ui:SymbolIcon Symbol="Play24" />
            </Button>
            <Button Command="{Binding PauseCommand}" ToolTip="Pause">
                <ui:SymbolIcon Symbol="Pause24" />
            </Button>
            <Button Command="{Binding StopCommand}" ToolTip="Stop">
                <ui:SymbolIcon Symbol="Stop24" />
            </Button>
            <Button Command="{Binding ResetCommand}" ToolTip="Reset">
                <ui:SymbolIcon Symbol="ArrowReset24" />
            </Button>
            <Separator />
            <TextBlock Text="FPS cap:" VerticalAlignment="Center" Margin="4,0" Opacity="0.7" />
            <ComboBox SelectedValue="{Binding SelectedSketch.TargetFrameRate}"
                      SelectedValuePath="Content"
                      Width="70"
                      ToolTip="Frame rate cap">
                <ComboBoxItem Content="15" />
                <ComboBoxItem Content="24" />
                <ComboBoxItem Content="30" />
                <ComboBoxItem Content="60" />
                <ComboBoxItem Content="120" />
            </ComboBox>
            <Separator />
            <Button Command="{Binding QuickExportCommand}" ToolTip="Quick Export">
                <ui:SymbolIcon Symbol="ArrowExportUp24" />
            </Button>
            <Separator />
            <Button Command="{Binding NewSketchCommand}" ToolTip="New Sketch">
                <ui:SymbolIcon Symbol="DocumentAdd24" />
            </Button>
            <Button Command="{Binding OpenSketchCommand}" ToolTip="Open Sketch">
                <ui:SymbolIcon Symbol="FolderOpen24" />
            </Button>
            <Button Command="{Binding SaveSketchCommand}" ToolTip="Save Sketch">
                <ui:SymbolIcon Symbol="Save24" />
            </Button>
        </ToolBar>

        <xcad:DockingManager Grid.Row="3"
                              DocumentsSource="{Binding OpenSketches}"
                              ActiveContent="{Binding SelectedSketch, Mode=TwoWay}">
            <xcad:DockingManager.Theme>
                <xcadThemes:WPFUITheme />
            </xcad:DockingManager.Theme>
            <xcad:DockingManager.LayoutItemContainerStyle>
                <Style TargetType="{x:Type xcad:LayoutItem}">
                    <Setter Property="Title" Value="{Binding Model.Title}" />
                </Style>
            </xcad:DockingManager.LayoutItemContainerStyle>
            <xcad:DockingManager.LayoutItemTemplate>
                <DataTemplate DataType="{x:Type vm:SketchTabViewModel}">
                    <engine:SketchViewport Loaded="OnSketchViewportLoaded"
                                            ShowGrid="{Binding DataContext.ShowGrid, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTemplate>
            </xcad:DockingManager.LayoutItemTemplate>
            <xcad:LayoutRoot>
                <xcad:LayoutPanel Orientation="Horizontal">
                    <xcad:LayoutAnchorablePane DockWidth="220">
                        <xcad:LayoutAnchorable Title="Explorer" CanClose="False" CanAutoHide="True">
                            <TextBlock Text="Project explorer — coming in a later phase."
                                       TextWrapping="Wrap"
                                       Margin="8"
                                       Opacity="0.6" />
                        </xcad:LayoutAnchorable>
                    </xcad:LayoutAnchorablePane>
                    <xcad:LayoutDocumentPane />
                    <xcad:LayoutAnchorablePane DockWidth="260" DockMinWidth="200">
                        <xcad:LayoutAnchorable Title="Sliders" CanClose="False" CanAutoHide="True">
                            <TextBlock Text="Intelligent sliders — coming in a later phase."
                                       TextWrapping="Wrap"
                                       Margin="8"
                                       Opacity="0.6" />
                        </xcad:LayoutAnchorable>
                        <xcad:LayoutAnchorable Title="Console" CanClose="False" CanAutoHide="True">
                            <TextBlock Text="Runtime console — coming in a later phase."
                                       TextWrapping="Wrap"
                                       Margin="8"
                                       Opacity="0.6" />
                        </xcad:LayoutAnchorable>
                    </xcad:LayoutAnchorablePane>
                </xcad:LayoutPanel>
            </xcad:LayoutRoot>
        </xcad:DockingManager>

        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding SelectedSketch.EngineStatus}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SelectedSketch.Fps, StringFormat='FPS: {0:0}'}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding SelectedSketch.MousePositionText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</ui:FluentWindow>
