<UserControl x:Class="P5CCS.App.Views.SlidersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:P5CCS.App.ViewModels"
             xmlns:local="clr-namespace:P5CCS.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SlidersPanelViewModel}"
             d:DesignWidth="280">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DataTemplate x:Key="NumberSliderTemplate" DataType="{x:Type vm:SliderItemViewModel}">
            <Border Margin="4" Padding="6" CornerRadius="4" Background="#14808080">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding NumberValue, StringFormat='{}{0:0.###}'}" Opacity="0.7" />
                    </Grid>
                    <Slider Minimum="{Binding Min}"
                            Maximum="{Binding Max}"
                            Value="{Binding NumberValue, Mode=TwoWay}"
                            SmallChange="{Binding Step}"
                            IsSnapToTickEnabled="False"
                            Margin="0,4" />
                    <WrapPanel>
                        <TextBlock Text="Min" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <ui:NumberBox Value="{Binding EditableMin, Mode=TwoWay}" Width="56" Margin="0,0,6,0" />
                        <TextBlock Text="Max" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <ui:NumberBox Value="{Binding EditableMax, Mode=TwoWay}" Width="56" Margin="0,0,6,0" />
                        <Button Content="Set" Command="{Binding ApplyBoundsCommand}" Padding="8,2" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <TextBlock Text="Animate:" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7" />
                        <ComboBox ItemsSource="{Binding AnimationModeOptions}" SelectedItem="{Binding AnimationMode}" Width="90" Margin="0,0,6,0" />
                        <ui:NumberBox Value="{Binding AnimationPeriodSeconds, Mode=TwoWay}" Width="56" ToolTip="Period (seconds)" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BooleanSliderTemplate" DataType="{x:Type vm:SliderItemViewModel}">
            <Border Margin="4" Padding="6" CornerRadius="4" Background="#14808080">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding BooleanValue, Mode=TwoWay}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ColorSliderTemplate" DataType="{x:Type vm:SliderItemViewModel}">
            <Border Margin="4" Padding="6" CornerRadius="4" Background="#14808080">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="24" Height="24" CornerRadius="4" BorderThickness="1" BorderBrush="#40808080">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding PreviewColor}" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="R" Width="14" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ColorR, Mode=TwoWay}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="G" Width="14" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ColorG, Mode=TwoWay}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="B" Width="14" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ColorB, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EnumSliderTemplate" DataType="{x:Type vm:SliderItemViewModel}">
            <Border Margin="4" Padding="6" CornerRadius="4" Background="#14808080">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding EnumOptions}" SelectedItem="{Binding EnumValue, Mode=TwoWay}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <local:SliderItemTemplateSelector x:Key="SliderItemTemplateSelector"
                                           NumberTemplate="{StaticResource NumberSliderTemplate}"
                                           BooleanTemplate="{StaticResource BooleanSliderTemplate}"
                                           ColorTemplate="{StaticResource ColorSliderTemplate}"
                                           EnumTemplate="{StaticResource EnumSliderTemplate}" />
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="6">
            <TextBlock Text="No numeric literals, colors, or booleans detected in this sketch yet."
                       TextWrapping="Wrap"
                       Opacity="0.6"
                       Visibility="{Binding HasNoSliders, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <WrapPanel>
                <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                         Width="110"
                         Margin="0,0,4,4" />
                <Button Content="Save Preset" Command="{Binding SavePresetCommand}" Margin="0,0,4,4" Padding="6,2" />
                <Button Content="Export" Command="{Binding ExportPresetsCommand}" Margin="0,0,4,4" Padding="6,2" />
                <Button Content="Import" Command="{Binding ImportPresetsCommand}" Margin="0,0,4,4" Padding="6,2" />
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding Presets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,4,4" Padding="4,2" CornerRadius="4" Background="#22808080">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <Button Content="Apply"
                                        Padding="4,0"
                                        Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="✕"
                                        Padding="4,0"
                                        Margin="2,0,0,0"
                                        Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SliderGroupViewModel}">
                        <Expander Header="{Binding Name}" IsExpanded="True" Margin="4,2">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource SliderItemTemplateSelector}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
