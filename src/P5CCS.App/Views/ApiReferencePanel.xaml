<UserControl x:Class="P5CCS.App.Views.ApiReferencePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:P5CCS.App.ViewModels"
             xmlns:completion="clr-namespace:P5CCS.Editor.Completion;assembly=P5CCS.Editor"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ApiReferenceViewModel}"
             d:DesignWidth="280">
    <DockPanel>
        <ui:TextBox DockPanel.Dock="Top"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Search the p5.js API..."
                    Margin="6"
                    Padding="6,4"
                    Icon="{ui:SymbolIcon Search24}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ApiCategoryViewModel}">
                        <Expander Header="{Binding Name}" IsExpanded="True" Margin="4,2">
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type completion:P5ApiEntry}">
                                        <Border Margin="4" Padding="6" CornerRadius="4" Background="#14808080">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Signature}" FontWeight="SemiBold" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
